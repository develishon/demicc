// 010.dc - fprintf at home

int main()
{
  fputf(1, "nscdcds", 11, "Bye, World! (additional text)", '\A', 42, '\A', 0 - 13, " is negative\A");
}

int fputf(int fd, int format)
{
  int typptr;
  int valptr;
  int typ;
  int val;
  int arg_length_value;
  int arg_length_present;
  int byte;
  
  valptr = &format + 8;
  typptr = format;
  
  while typ = ld_u8(typptr)
  {
    val = *valptr;
  
    if typ == 's'
    {
      int size;
      
      if arg_length_present
      {
        size = arg_length_value;
      }
      else
      {
        size = 0;
        
        while ld_u8(val + size)
        {
          size += 1;
        }
      }
      
      syscall(1, fd, val, size, 0, 0, 0);
    }
    else if typ == 'c'
    {
      st_u8(&byte, val);
      syscall(1, fd, &byte, 1, 0, 0, 0);
    }
    else if typ == 'n'
    {
      arg_length_value = val;
      arg_length_present = 1;
    }
    else if typ == 'd'
    {
      int power;
      
      power = 10;
      
      if val < 0
      {
        val *= 0 - 1;
        syscall(1, fd, "-", 1, 0, 0, 0);
      }
      
      while val / power
      {
        power *= 10;
      }
      
      while power > 1
      {
        power /= 10;
        st_u8(&byte, val / power % 10 + '0');
        syscall(1, fd, &byte, 1, 0, 0, 0);
      }
    }
    else
    {
      syscall(1, fd, "<INVALID FORMAT>", 16, 0, 0, 0);
    }
    
    if typ != 'n'
    {
      arg_length_present = 0;
      arg_length_value = 0;
    }
    
    typptr += 1;
    valptr += 8;
  }
}


