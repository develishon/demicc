// 005.dc - pyramid

int main()
{
  int y;
  int h;
  
  y = 0;
  h = 10;
  
  while y < h
  {
    y += 1;
    putline(h - y, ' ');
    putline(y * 2 - 1, '#');
    putline(1, '\0A');
  }
}

int putline(int n, int c)
{
  int byte;
  
  st_u8(&byte, c);

  while n > 0
  {
    n -= 1;
    syscall(1, 1, &byte, 1, 0, 0, 0);
  }
}


