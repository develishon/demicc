// 007.dc - sum

int main(int argc, int argv)
{
  int sum;
  int i;
  
  sum = 0;
  i = 1;
  
  while i < argc
  {
    sum += int_from_string(*(i * 8 + argv));
    i += 1;
  }
  
  putdec(sum);
  putchr('\A');
}

int int_from_string(int s)
{
  int number;
  int c;
  
  number = 0;
  
  while ld_u8(s)
  {
    c = ld_u8(s);
  
    if ('0' <= c) & (c <= '9')
    {
      number = number * 10 + c - '0';
    }
    
    s += 1;
  }
  
  return number;
}

int putdec(int number)
{
  int power;
  
  power = 10;
  
  while number / power != 0
  {
    power *= 10;
  }
  
  while power > 1
  {
    power /= 10;
    putchr(number / power % 10 + '0');
  }
}

int putchr(int ch)
{
  int byte;
  
  st_u8(&byte, ch);
  syscall(1, 1, &byte, 1, 0, 0, 0);
}


